# MetaTrader 5
MT5_LOGIN=123423443
MT5_PASSWORD=234434534
MT5_SERVER=MetaQuotes-Demo
MT5_PATH=                      # Windows only — leave blank on Mac/Linux

# AiFxBridge — MQL5 EA file-based bridge (Mac native MT5 app)
# This is the MT5 Common/Files folder — shared between MT5 and Python
MT5_BRIDGE_FILES=~/Library/Application Support/net.metaquotes.wine.metatrader5/drive_c/users/user/AppData/Roaming/MetaQuotes/Terminal/Common/Files

# MT5 Docker bridge (Mac/Linux — pymt5linux, used as fallback)
MT5_HOST=localhost
MT5_PORT=8001

# MT5 VNC web UI credentials (set anything you want)
MT5_VNC_USER=admin
MT5_VNC_PASSWORD=admin

# Model
MODEL_NAME=kronos
KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-base
KRONOS_MODEL=NeoQuasar/Kronos-base
KRONOS_DEVICE=cpu
KRONOS_CONTEXT=512
KRONOS_PRED_LEN=5
KRONOS_TEMPERATURE=0.5     # 0.1=deterministic, 1.0=random
KRONOS_SAMPLES=3          # samples averaged per inference call

# Signal defaults
DEFAULT_TIMEFRAME=H1
DEFAULT_MIN_PIPS=15
DEFAULT_STOP_LOSS_PIPS=20
DEFAULT_RISK_REWARD=3.0
DEFAULT_RISK_PERCENT=10.0
DEFAULT_LOT_SIZE=1.0
DEFAULT_MAX_SPREAD=3.0
SIGNAL_EXPIRY_SECONDS=300
CONFIDENCE_THRESHOLD=0.62

# Sessions (comma-separated)
ACTIVE_SESSIONS=LONDON,NEW_YORK  # options: LONDON,NEW_YORK,ASIA,TOKYO,SYDNEY

# News
FINBERT_MODEL=ProsusAI/finbert
NEWS_BLACKOUT_MINUTES=30

# API
FX_API_KEY=change-me-to-a-strong-random-key
API_HOST=0.0.0.0
API_PORT=8022
API_DEBUG=false
SCHEDULE_LOG_PATH=logs/schedule-execution.log

# Database
POSTGRES_USER=fx
POSTGRES_PASSWORD=fx
POSTGRES_DB=fxtrader
DATABASE_URL=postgresql+asyncpg://fx:fx@db:5432/fxtrader
DATABASE_URL_SYNC=postgresql://fx:fx@db:5432/fxtrader
TELEGRAM_BOT_TOKEN=8999e
TELEGRAM_CHAT_ID=adfdfd

# Resend (email notifications) — get your API key at resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=signals@yourdomain.com